# ---------------------------------------------------------------------------
# M3E4Unity
# ---------------------------------------------------------------------------

# Build outputs and renders
/Builds/
Shots/
*.log

# ---------------------------------------------------------------------------
# Unity (the Showcase project and any test project placed in the repo)
# ---------------------------------------------------------------------------
/Showcase/[Ll]ibrary/
/Showcase/[Tt]emp/
/Showcase/[Oo]bj/
/Showcase/[Bb]uild/
/Showcase/[Bb]uilds/
/Showcase/[Ll]ogs/
/Showcase/[Uu]ser[Ss]ettings/
/Showcase/[Mm]emoryCaptures/
/Showcase/[Rr]ecordings/
/Showcase/*.csproj
/Showcase/*.sln
/Showcase/*.unityproj
/Showcase/.vsconfig

# Generated by the M3E4Unity builders (Tools > M3E4Unity re-creates them):
# the shape atlas, the TMP font assets, the default theme and the showcase scene.
/Showcase/Assets/M3E4Unity.Generated/
/Showcase/Assets/M3E4Unity.Generated.meta
/Showcase/Assets/M3Showcase/
/Showcase/Assets/M3Showcase.meta

# Unity crash / player artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Local test projects kept next to the package (e.g. a VRChat world project)
/VRC_*/
/TestProject*/

# ---------------------------------------------------------------------------
# .NET (Tests/CoreTests, Tests/UnityCompile)
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user
*.suo
*.pdb
*.mdb

# Golden-data generation scratch (Tests/golden/make_golden.ps1)
/Tests/golden/build/
/Tests/golden/*.class

# ---------------------------------------------------------------------------
# Python (tools/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# ---------------------------------------------------------------------------
# IDEs and OS
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
