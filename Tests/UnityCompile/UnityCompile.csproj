<!--
  Fast compile check of the Unity-side code without launching Unity:
    dotnet build Tests/UnityCompile -p:UnityProject=../VRC_M3E4Unity
  References the engine DLLs and the test project's compiled script assemblies.
  Defines UDONSHARP like a VRChat project; pass -p:VRChat=false to check the plain-Unity path.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0414;CS0649;CS0169;CS1998</NoWarn>
    <UnityEditorDir Condition="'$(UnityEditorDir)' == ''">C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data</UnityEditorDir>
    <UnityProject Condition="'$(UnityProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\VRC_M3E4Unity</UnityProject>
    <VRChat Condition="'$(VRChat)' == ''">true</VRChat>
    <DefineConstants Condition="'$(VRChat)' == 'true'">$(DefineConstants);UDONSHARP;UNITY_EDITOR;UNITY_2022_3_OR_NEWER</DefineConstants>
    <DefineConstants Condition="'$(VRChat)' != 'true'">$(DefineConstants);UNITY_EDITOR;UNITY_2022_3_OR_NEWER</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Packages\com.m3e4unity\Runtime\**\*.cs" />
    <Compile Include="..\..\Packages\com.m3e4unity\Editor\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityEditorDir)\Managed\UnityEngine\*.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\UnityEditor.UI.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\Unity.TextMeshPro.Editor.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(VRChat)' == 'true'">
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\UdonSharp.Runtime.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\UdonSharp.Editor.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\VRC.Udon.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\VRC.Udon.Editor.dll" Private="false" />
    <Reference Include="$(UnityProject)\Packages\com.vrchat.worlds\Runtime\Udon\External\VRC.Udon.Common.dll" Private="false" />
    <Reference Include="$(UnityProject)\Library\ScriptAssemblies\VRC.SDK3.dll" Private="false" />
    <Reference Include="$(UnityProject)\Packages\com.vrchat.base\Runtime\VRCSDK\Plugins\VRCSDKBase.dll" Private="false" />
    <Reference Include="$(UnityProject)\Packages\com.vrchat.worlds\Runtime\VRCSDK\Plugins\VRCSDK3.dll" Private="false" />
  </ItemGroup>
</Project>
